{
  "manifest_version": 3,
  "name": "FB & YT 智能营销助手",
  "short_name": "FB & YT Auto-Responder",
  "version": "1.7.1",
  "description": "全自动驻留 Facebook 评论管理工具 & YouTube Studio 评论后台，双平台集中监控、智能私信与公开回复，极致防封安全稳定。",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon48.png",
    "default_title": "FB & YT 智能营销助手 v1.7.1"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://studio.youtube.com/*",
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "utils/storage.js",
        "content/comments_manager_scrub.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "utils/storage.js",
        "content/youtube_studio_scrub.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon48.png"
      ],
      "matches": [
        "https://*.facebook.com/*",
        "https://studio.youtube.com/*"
      ]
    }
  ],
  "options_page": "dashboard/dashboard.html"
}